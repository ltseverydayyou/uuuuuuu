local function sampleRenderFps(frames)
	local render = game:GetService("RunService").RenderStepped
	render:Wait()
	local total, count = 0, 0
	for _ = 1, frames do
		local dt = render:Wait()
		if dt > 0 then
			total += 1 / dt
			count += 1
		end
	end
	return count > 0 and total / count or 0
end

local function fpsCapCheck(getter, setter)
	local before = getter()
	assert(type(before) == "number" and before >= 0 and before == before, "FPS cap getter returned an invalid number")
	local baseline = sampleRenderFps(6)
	local target = 30
	if before > 0 and before <= 35 then target = 45 end
	defer(function() setter(before) end)
	setter(target)
	task.wait(0.2)
	local reported = getter()
	assert(type(reported) == "number" and math.abs(reported - target) <= 1, "configured FPS cap did not round-trip through getter")
	local measured = sampleRenderFps(10)
	setter(before)
	assert(math.abs(getter() - before) <= 1, "FPS cap restoration was not reported")
	if baseline > target * 1.35 then
		assert(measured < target * 1.5 and measured > target * 0.45, "RenderStepped pacing did not reflect the configured cap")
		return string.format("reported %.0f and measured %.1f fps at target %d", reported, measured, target)
	end
	partial(string.format("getter/setter/restoration verified; baseline %.1f fps was too low for an independent pacing oracle", baseline))
end

