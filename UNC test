local function record(test, status, detail, used, elapsed)
	local row = { name = test.name, group = test.group, status = status, detail = short(detail or ""), alias = used, seconds = elapsed or 0 }
	table.insert(report.results, row)
	report.counts[status] = (report.counts[status] or 0) + 1
	if status ~= "EXCLUDED" then
		local message = prefix .. "[" .. (statusEmoji[status] or "❔") .. "] " .. test.name .. (used and used ~= test.name and " via " .. used or "") .. (row.detail ~= "" and " - " .. row.detail or "")
		if warningStatus[status] then warn(message) else print(message) end
	end
end

local function runOne(test)
	if not selected(test.name) then record(test, "EXCLUDED", "not selected") return end
	local fn, used, invalid = resolve(test.aliases or test.name)
	if test.value then fn, used = exposed(test.name), test.name end
	if fn == nil then record(test, invalid and "FAIL" or "MISSING", invalid or "not exposed") return end
	if not test.run then record(test, "UNTESTED", test.note or "available; no reliable behavioral oracle", used) return end
	if test.network and config.Network == false then record(test, "UNTESTED", "network checks disabled", used) return end
	current = { cleanup = {}, closed = false }
	local scope = current
	local started = os.clock()
	local ok, result, timedOut = bounded(function() return test.run(fn) end, math.clamp(tonumber(test.timeout or config.Timeout) or 8, 0.1, 30))
	scope.closed = true
	local cleanupErrors = {}
	for i = #scope.cleanup, 1, -1 do
		local clean, errorMessage = bounded(scope.cleanup[i], 3)
		if not clean then table.insert(cleanupErrors, short(errorMessage)) end
	end
	current = nil
	local status, detail = "PASS", result
	if not ok then
		if type(result) == "table" and result.token == skipToken then status, detail = result.status, result.reason
		else status, detail = timedOut and "TIMEOUT" or "FAIL", result end
	end
	if #cleanupErrors > 0 then
		table.insert(report.cleanupErrors, { name = test.name, errors = cleanupErrors })
		detail = status .. ": " .. short(detail or "") .. "; cleanup: " .. table.concat(cleanupErrors, "; ")
		status = "CLEANUP_ERROR"
	end
	record(test, status, detail, used, os.clock() - started)
	if #cleanupErrors > 0 then error("stopped after cleanup failure in " .. test.name, 0) end
end

local function gameCallerProbe(checkFn, captureFn)
	local hook = need("hookmetamethod")
	local wrap = need("newcclosure")
	local old
	local captured
	local seen = false
	old = hook(game, "__index", wrap(function(self, key)
		if not seen and checkFn() == false then
			local ok, value = pcall(captureFn, self, key)
			if ok then
				captured = value
				seen = true
			end
		end
		return old(self, key)
	end))
	defer(function() hook(game, "__index", old) end)
	assert(waitFor(function() return seen end, 2), "no game-owned __index call was observed")
	return captured
end

register("checkcaller", function(fn)
	assert(fn() == true, "executor-owned test thread was not identified")
	assert(gameCallerProbe(fn, function() return true end) == true, "game-owned call was not classified as non-executor")
	return "executor-owned true and game-owned false cases verified"
end)

register("clonefunction", function(fn)
	local state = { n = 4 }
	local function original(x, ...) return state.n + x, ... end
	local copy = fn(original)
	assert(type(copy) == "function" and copy ~= original, "expected a distinct closure")
	local result = table.pack(copy(3, nil, 9))
	assert(result.n == 3 and result[1] == 7 and result[2] == nil and result[3] == 9, "clone lost arguments or upvalues")
	state.n = 8
	assert(copy(2) == 10, "clone did not share the original upvalue")
	local native = fn(math.abs)
	assert(type(native) == "function" and native ~= math.abs and native(-7) == 7, "C closure clone failed")
end)

register("getfunctionhash", function(fn)
	local function a() return "unc-hash-a" end
	local function b() return "unc-hash-b" end
	local first = fn(a)
	assert(type(first) == "string" and #first == 96 and first:match("^%x+$"), "expected hexadecimal SHA-384")
	assert(first == fn(a) and first ~= fn(b), "hash unstable or ignores function contents")
	local clone = need("clonefunction")(a)
	assert(fn(clone) == first, "identical bytecode differs when closure identity changes")
	need("debug.setconstant")(a, 1, "unc-hash-changed")
	assert(fn(a) ~= first, "hash did not change after a constant mutation")
	assert(not pcall(fn, print), "C closures should be rejected by the documented hash contract")
end)

register("hookfunction", function(fn)
	local function target(x, ...) return x + 1, ... end
	local reference = target
	local old = fn(target, function(x, ...) return x + 13, ... end)
	assert(type(old) == "function", "missing original callback")
	defer(function() fn(target, old) assert(target(2) == 3, "hook restoration failed") end)
	assert(reference(2) == 15, "preexisting reference did not change")
	local result = table.pack(old(2, nil, 7))
	assert(result.n == 3 and result[1] == 3 and result[3] == 7, "original callback was corrupted")
end)

register("hookmetamethod", function(fn)
	local target = setmetatable({}, { __index = function(_, key) return "original:" .. key end })
	local old = fn(target, "__index", function(_, key) return "hooked:" .. key end)
	assert(type(old) == "function", "missing original metamethod")
	defer(function() fn(target, "__index", old) assert(target.probe == "original:probe", "metamethod restoration failed") end)
	assert(target.probe == "hooked:probe", "metamethod did not change")
	assert(old(target, "probe") == "original:probe", "original metamethod corrupted")
end)

