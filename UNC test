end

local function waitFor(predicate, timeout)
	local deadline = os.clock() + (timeout or 1.5)
	repeat
		if predicate() then return true end
		task.wait()
	until os.clock() >= deadline
	return predicate()
end

local function bounded(fn, seconds)
	local done, values = false, nil
	local worker = coroutine.create(function()
		values = table.pack(pcall(fn))
		done = true
	end)
	task.spawn(worker)
	local deadline = os.clock() + seconds
	while not done and os.clock() < deadline do task.wait() end
	if not done then
		local cancelled, reason = pcall(task.cancel, worker)
		if not cancelled then return false, "could not cancel timed-out worker: " .. tostring(reason), true end
		return false, "timed out after " .. seconds .. "s (worker cancelled)", true
	end
	return table.unpack(values, 1, values.n)
end

