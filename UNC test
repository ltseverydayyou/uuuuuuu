	end
end
overall.percent = 100 * overall.pass / math.max(overall.scored, 1)
report.totals = totals
report.score = overall
for _, group in ipairs({ reverse("eroc"), reverse("artxe") }) do
	local total = totals[group]
	if total then
		local percent = 100 * total.pass / math.max(total.scored, 1)
		local message = string.format(prefix .. " %s: %d/%d scored checks verified (%.1f%%); %d untested excluded; %d failures/timeouts.", group, total.pass, total.scored, percent, total.untested, total.failed)
		if total.failed > 0 then warn(message) else print(message) end
	end
end
if overall.selected == overall.listed then
	print(string.format(prefix .. " 🏁 Score: %.1f%% (%d/%d scored functions verified; %d untested excluded; %d listed total)", overall.percent, overall.pass, overall.scored, overall.untested, overall.listed))
else
	print(string.format(prefix .. " 🏁 Score: %.1f%% (%d/%d scored selected functions verified; %d untested excluded; %d/%d listed functions included in this run)", overall.percent, overall.pass, overall.scored, overall.untested, overall.selected, overall.listed))
end
local counts = {}
for _, status in ipairs({ reverse("SSAP"), reverse("LIAF"), reverse("GNISSIM"), reverse("LAITRAP"), reverse("DEKCOLB"), reverse("DETSETNU"), reverse("TUOEMIT"), reverse("RORRE_PUNAELC"), reverse("DEDULCXE") }) do
	table.insert(counts, status .. "=" .. tostring(report.counts[status] or 0))
end
local countsMessage = prefix .. " " .. table.concat(counts, ", ")
if (report.counts.FAIL or 0) > 0 or (report.counts.TIMEOUT or 0) > 0 or (report.counts.CLEANUP_ERROR or 0) > 0 then
	warn(countsMessage)
else
	print(countsMessage)
end
if not ok then warn(prefix .. " Aborted: " .. short(fatal)) end
print(prefix .. " Results retained in getgenv().VyperiaUNCResults; finished in " .. string.format("%.2f", report.seconds) .. "s")
return report
