local function scriptCandidates()
	local configured = config.ScriptFixture
	if typeof(configured) == "Instance" and configured:IsA("LocalScript") then return { configured } end
	local player = game:GetService("Players").LocalPlayer
	local values, seen = {}, {}
	local function add(value)
		if typeof(value) == "Instance" and value:IsA("LocalScript") and not seen[value] then
			seen[value] = true
			table.insert(values, value)
		end
	end
	local character = player and player.Character
	add(character and character:FindFirstChild("Animate"))
	local scripts = player and player:FindFirstChildOfClass("PlayerScripts")
	add(scripts and scripts:FindFirstChild("RbxCharacterSounds"))
	if scripts then
		for _, value in ipairs(scripts:GetDescendants()) do add(value) end
	end
	if character then
		for _, value in ipairs(character:GetDescendants()) do add(value) end
	end
	return values
end

local function scriptFixture()
	local values = scriptCandidates()
	if #values == 0 then blocked("no LocalScript fixture; set VyperiaUNCConfig.ScriptFixture") end
	return values[1]
end

local function runningScriptFixture(getEnv)
	getEnv = getEnv or need("getsenv")
	local configured = config.ScriptFixture
	for _, candidate in ipairs(scriptCandidates()) do
		local ok, value = pcall(getEnv, candidate)
		if ok and type(value) == "table" and value.script == candidate then return candidate, value end
		if candidate == configured then blocked("VyperiaUNCConfig.ScriptFixture is not an active same-state LocalScript") end
	end
	blocked("no active same-state LocalScript fixture with a matching getsenv().script")
end

