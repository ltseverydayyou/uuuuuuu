local function exposed(name)
	if type(name) ~= "string" then return nil end
	local root, tail = name:match("^([^.]+)%.(.+)$")
	if not root then
		local value = env[name]
		if value == nil and globalEnv ~= env then value = globalEnv[name] end
		return value
	end
	if not executorNamespaces[root] then return nil end
	for _, source in ipairs({ env, globalEnv }) do
		local value = source[root]
		if value ~= nil then
			local ok = pcall(function()
				for part in tail:gmatch("[^.]+") do
					value = value[part]
					if value == nil then break end
				end
			end)
			if ok and value ~= nil then return value end
		end
	end
end

local function resolve(names)
	if type(names) == "string" then names = { names } end
	local invalid
	for _, name in ipairs(names) do
		local value = exposed(name)
		if type(value) == "function" then return value, name end
		if value ~= nil then invalid = name .. " is " .. type(value) end
	end
	return nil, nil, invalid
end

local function outcome(status, reason)
	error({ token = skipToken, status = status, reason = reason }, 0)
end

local function blocked(reason) outcome("BLOCKED", reason) end
local function untested(reason) outcome("UNTESTED", reason) end
local function partial(reason) outcome("PARTIAL", reason) end
local function need(names)
	local fn, _, invalid = resolve(names)
	if not fn then blocked(invalid or ("missing dependency: " .. (type(names) == "table" and table.concat(names, ", ") or names))) end
	return fn
end

local function defer(fn)
	assert(current and not current.closed, "cleanup registered outside an active test")
	table.insert(current.cleanup, fn)
end

local function new(class, parent)
	local object = nativeInstance.new(class)
	defer(function() object:Destroy() end)
