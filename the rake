						esp.players[p] = {
							o = ch,
							d = esp.drawTxt(p.Name, Color3.fromRGB(0, 255, 34)),
							h = esp.cham(ch, "PlayerChams", Color3.fromRGB(0, 11, 170), Color3.fromRGB(170, 170, 170), 0.3),
