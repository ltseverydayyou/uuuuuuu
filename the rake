			local v = ffc(cur, name)
			if v then
				return valOf(v, "?")
			end
			local ok, attr = pcall(function()
				return cur:GetAttribute(name)
			end)
			if ok and attr ~= nil then
				return attr
			end
			cur = cur.Parent
		end
		return "?"
	end

