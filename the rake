					clientBypass.fillStamina(ch)
					return
				end
				return old.RegenStaminaHandler(ch, ...)
			end
		end
		if old.Update then
			lib.Update = function(ch, ...)
				clientBypass.stamCap(ch)
				local a, b, c = old.Update(ch, ...)
				clientBypass.stamCap(ch)
